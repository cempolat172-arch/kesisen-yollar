def haversine_distance(coord1, coord2):
  r = 6371000
  lat1, lon1 = map(math.radians, coord1)
  lat2, lon2 = map(math.radians, coord2)
  dlat = lat2 - lat1
  dlon = lon2 - lon1
  a = (
      math.sin(dlat / 2) ** 2
      + math.cos(lat1) * math.cos(lat2) * math.sin(dlon / 2) ** 2
  )
  return r * (2 * math.asin(math.sqrt(a)))


def parse_takeout(content_bytes):
  try:
    data = json.loads(content_bytes.decode("utf-8"))
  except Exception:
    raise HTTPException(status_code=400, detail="Geçersiz JSON dosyası.")

  locations = data.get("locations", [])
  if not locations and isinstance(data, list):
    locations = data

  parsed = []
  for loc in locations:
    timestamp_str = loc.get("timestamp") or loc.get("time")
    lat = loc.get("latitudeE7")
    lon = loc.get("longitudeE7")

    if lat is not None and lon is not None:
      lat_deg = lat / 1e7
      lon_deg = lon / 1e7
    elif "latitude" in loc and "longitude" in loc:
      lat_deg = loc["latitude"]
      lon_deg = loc["longitude"]
    else:
      continue

    if timestamp_str:
      try:
        ts = datetime.fromisoformat(timestamp_str.replace("Z", "+00:00"))
        parsed.append({"timestamp": ts, "lat": lat_deg, "lon": lon_deg})
      except Exception:
        continue

  parsed.sort(key=lambda x: x["timestamp"])
  return parsed


def calculate_matches(points_a, points_b, max_dist=200, max_time_sec=1800):
  encounters = []
  i, j = 0, 0
