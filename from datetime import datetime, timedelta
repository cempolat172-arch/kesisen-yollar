        <script>
            let currentRoomId = null;
            let encountersData = [];

            function switchTab(mode) {
                const tabTog = document.getElementById('tabTogetherBtn');
                const tabRem = document.getElementById('tabRemoteBtn');
                const modeTog = document.getElementById('modeTogether');
                const modeRem = document.getElementById('modeRemote');
                if (mode === 'together') {
                    tabTog.className = 'flex-1 py-2 rounded-xl bg-rose-500 text-white transition';
                    tabRem.className = 'flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition';
                    modeTog.classList.remove('hidden');
                    modeRem.classList.add('hidden');
                } else {
                    tabRem.className = 'flex-1 py-2 rounded-xl bg-rose-500 text-white transition';
                    tabTog.className = 'flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition';
                    modeRem.classList.remove('hidden');
                    modeTog.classList.add('hidden');
                }
            }

            async function compareTogether() {
                const f1 = document.getElementById('fileUser1').files[0];
                const f2 = document.getElementById('fileUser2').files[0];
                if (!f1 || !f2) return alert('Lütfen iki partnerin de JSON dosyasını seçin.');
                const formData = new FormData();
                formData.append('file1', f1);
                formData.append('file2', f2);
                const res = await fetch('/api/compare-together', { method: 'POST', body: formData });
                const data = await res.json();
                if (!res.ok) return alert(data.detail || 'Bir hata oluştu.');
                currentRoomId = data.room_id;
                encountersData = data.encounters;
                showPreview(data.total_encounters, encountersData[0]?.date || 'Bilinmiyor');
            }

            async function createRoomRemote() {
                const f = document.getElementById('fileRemote').files[0];
                if (!f) return alert('Lütfen önce bir .json dosyası seçin.');
                const formData = new FormData();
                formData.append('file', f);
                const res = await fetch('/api/create-room', { method: 'POST', body: formData });
                const data = await res.json();
                if (!res.ok) return alert(data.detail || 'Hata oluştu.');
                currentRoomId = data.room_id;
                const alertBox = document.getElementById('roomAlert');
                alertBox.classList.remove('hidden');
                alertBox.innerHTML = `Oda Kodunuz: <b class="text-white select-all text-sm">${data.room_id}</b><br><span class="text-slate-400 text-[11px]">Partneriniz bu kodu girip kendi dosyasını yüklemeli.</span>`;
            }

            async function joinRoomRemote() {
                const code = document.getElementById('remoteCodeInput').value.trim().toUpperCase();
                const f = document.getElementById('fileRemote').files[0];
                if (!code || !f) return alert('Hem oda kodunu girin hem de dosyanızı seçin.');
                const formData = new FormData();
                formData.append('file', f);
                const res = await fetch(`/api/join-room/${code}`, { method: 'POST', body: formData });
                const data = await res.json();
                if (!res.ok) return alert(data.detail || 'Bir hata oluştu.');
                currentRoomId = code;
                encountersData = data.encounters;
                showPreview(data.total_encounters, encountersData[0]?.date || 'Bilinmiyor');
            }

            async function startDemo() {
                const res = await fetch('/api/demo-room', { method: 'POST' });
                const data = await res.json();
                currentRoomId = data.room_id;
                encountersData = data.encounters;
                showPreview(data.total_encounters, encountersData[0]?.date);
            }

            function showPreview(count, firstDate) {
                document.getElementById('uploadSection').classList.add('hidden');
                document.getElementById('previewSection').classList.remove('hidden');
                document.getElementById('encounterCount').innerText = count;
                document.getElementById('firstEncounterDate').innerText = firstDate;
                setTimeout(() => {
                    const blurMap = L.map('mapBlur', { zoomControl: false, attributionControl: false }).setView([41.0082, 28.9784], 12);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(blurMap);
                }, 200);
            }

            async function triggerPayment() {
                const res = await fetch(`/api/pay-room/${currentRoomId}`, { method: 'POST' });
                const data = await res.json();
                if (data.status === 'success') {
                    document.getElementById('previewSection').classList.add('hidden');
                    document.getElementById('fullReportSection').classList.remove('hidden');
                    renderPaidMap(encountersData);
                }
            }

            function renderPaidMap(points) {
                setTimeout(() => {
                    const first = points[0] || { lat: 41.0082, lon: 28.9784 };
                    const mapInstance = L.map('paidMap').setView([first.lat, first.lon], 13);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapInstance);
                    const timeline = document.getElementById('timelineList');
                    timeline.innerHTML = '';
                    points.forEach((p, index) => {
                        L.marker([p.lat, p.lon]).addTo(mapInstance).bindPopup(`<b>Kesişme #${index + 1}</b><br>${p.date}<br>Mesafe: ${p.distance_m}m`);
                        const item = document.createElement('div');
                        item.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl flex justify-between items-center';
                        item.innerHTML = `<div><div class="font-bold text-slate-200">#${index + 1} Karşılaşma</div><div class="text-[11px] text-slate-500">${p.date}</div></div><span class="text-rose-400 font-semibold text-[11px]">~${p.distance_m}m</span>`;
                        timeline.appendChild(item);
                    });
                }, 200);
            }

            function generateStoryCard() {
                const canvas = document.getElementById('storyCanvas');
                const ctx = canvas.getContext('2d');

                // Arka plan gradyanı
                const grad = ctx.createLinearGradient(0, 0, 0, 1920);
                grad.addColorStop(0, '#090d16');
                grad.addColorStop(0.5, '#1e112a');
                grad.addColorStop(1, '#090d16');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, 1080, 1920);

                // Kart çerçevesi
                ctx.strokeStyle = 'rgba(244, 63, 94, 0.3)';
                ctx.lineWidth = 4;
                ctx.strokeRect(60, 60, 960, 1800);

                // Başlık
                ctx.fillStyle = '#f43f5e';
                ctx.font = 'bold 50px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('✨ KESİŞEN YOLLAR RAPORU', 540, 400);

                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 70px sans-serif';
                ctx.fillText('Tanışmadan Önce', 540, 520);
                ctx.fillText('Yollarımız Kesişmiş!', 540, 610);

                // Kesişme Sayısı
                ctx.fillStyle = '#f43f5e';
                ctx.font = '900 220px sans-serif';
                ctx.fillText(encountersData.length.toString(), 540, 900);

                ctx.fillStyle = '#cbd5e1';
                ctx.font = '500 55px sans-serif';
                ctx.fillText('Kez Aynı Yerdeydik', 540, 1000);

                // İlk Karşılaşma Kutusu
                ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
                ctx.roundRect(160, 1150, 760, 220, [30]);
                ctx.fill();

                ctx.fillStyle = '#94a3b8';
                ctx.font = '40px sans-serif';
                ctx.fillText('İlk Karşılaşma Tarihi', 540, 1230);

                ctx.fillStyle = '#fb7185';
                ctx.font = 'bold 55px sans-serif';
                ctx.fillText(encountersData[0]?.date || '-', 540, 1310);

                // Footer / Link
                ctx.fillStyle = '#64748b';
                ctx.font = '36px sans-serif';
                ctx.fillText('Sen de sevgilinle test et:', 540, 1680);

                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 44px sans-serif';
                ctx.fillText('kesisenyollar.com', 540, 1740);

                // İndirme tetikle
                const link = document.createElement('a');
                link.download = 'kader-raporumuz.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
            }
        </script>
    </body>
    </html>
    """


@app.post("/api/compare-together")
async def compare_together(
    file1: UploadFile = File(...), file2: UploadFile = File(...)
):
  p1 = parse_takeout(await file1.read())
  p2 = parse_takeout(await file2.read())
  encounters = calculate_matches(p1, p2)
  room_id = str(uuid.uuid4())[:6].upper()
  ROOMS[room_id] = {"encounters": encounters, "is_paid": False}
  return {
      "room_id": room_id,
      "total_encounters": len(encounters),
      "encounters": encounters,
  }


@app.post("/api/create-room")
async def create_room(file: UploadFile):
  content = await file.read()
  user_points = parse_takeout(content)
  room_id = str(uuid.uuid4())[:6].upper()
  ROOMS[room_id] = {"points": user_points}
  return {"room_id": room_id}


@app.post("/api/join-room/{room_id}")
async def join_room(room_id: str, file: UploadFile):
  room_id = room_id.upper()
  if room_id not in ROOMS:
    raise HTTPException(
        status_code=404, detail="Oda bulunamadı veya süresi doldu."
    )
  room = ROOMS[room_id]
  content = await file.read()
  user2_points = parse_takeout(content)
  encounters = calculate_matches(room["points"], user2_points)
  ROOMS[room_id] = {"encounters": encounters, "is_paid": False}
  return {"total_encounters": len(encounters), "encounters": encounters}


