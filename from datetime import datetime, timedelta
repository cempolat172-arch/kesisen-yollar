  while i < len_a and j < len_b:
    t_a = points_a[i]["timestamp"]
    t_b = points_b[j]["timestamp"]
    diff = (t_a - t_b).total_seconds()

    if abs(diff) <= max_time_sec:
      dist = haversine_distance(
          (points_a[i]["lat"], points_a[i]["lon"]),
          (points_b[j]["lat"], points_b[j]["lon"]),
      )
      if dist <= max_dist:
        encounters.append({
            "date": t_a.strftime("%d.%m.%Y %H:%M"),
            "lat": round((points_a[i]["lat"] + points_b[j]["lat"]) / 2, 6),
            "lon": round((points_a[i]["lon"] + points_b[j]["lon"]) / 2, 6),
            "distance_m": round(dist, 1),
        })

    if t_a < t_b:
      i += 1
    else:
      j += 1

  return encounters


